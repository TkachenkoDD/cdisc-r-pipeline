         <MethodDef OID="MT.MT.AGEGR1" Name="Age Group 1 Character" Type="">
            <Description>
               <TranslatedText>Character variable derived from ADSL.AGEGR1N.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.AGEGR1N" Name="Age Group 1 Numeric" Type="">
            <Description>
               <TranslatedText>Derived based on AGE: AGEGR1N = 1 if AGE &lt; 65; AGEGR1N = 2 if 65 &lt;= AGE &lt;= 80; AGEGR1N = 3 if AGE &gt; 80.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.AVGDD" Name="Average Daily Dose" Type="">
            <Description>
               <TranslatedText>Calculated as: CUMDOSE / TRTDUR.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.BMIBL" Name="Baseline Body Mass Index" Type="">
            <Description>
               <TranslatedText>Calculated as: WEIGHTBL / ((HEIGHTBL / 100)**2).</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.BMIBLGR1" Name="Baseline BMI Group 1" Type="">
            <Description>
               <TranslatedText>Grouped as: 'Normal' if . &lt; BMIBL &lt; 25; 'Overweight' if 25 &lt;= BMIBL &lt; 30; 'Obese' if BMIBL &gt;= 30.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.COMP16FL" Name="Completer Week 16 Flag" Type="">
            <Description>
               <TranslatedText>Set to 'Y' if subject has SV.VISITNUM = 10 and ENDDT &gt;= date of visit 10. Set to 'N' otherwise.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.COMP24FL" Name="Completer Week 24 Flag" Type="">
            <Description>
               <TranslatedText>Set to 'Y' if subject has SV.VISITNUM = 12 and ENDDT &gt;= date of visit 12. Set to 'N' otherwise.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.COMP8FL" Name="Completer Week 8 Flag" Type="">
            <Description>
               <TranslatedText>Set to 'Y' if subject has SV.VISITNUM = 8 and ENDDT &gt;= date of visit 8. Set to 'N' otherwise.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.CUMDOSE" Name="Cumulative Dose" Type="">
            <Description>
               <TranslatedText>For ARMN=0 or 1: CUMDOSE = TRT01PN * TRTDUR. For ARMN=2: CUMDOSE will be based on 54mg per day for the number of days subject was in treatment.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.DCDECOD" Name="Standardized Discontinuation Reason" Type="">
            <Description>
               <TranslatedText>DS.DSDECOD where DSCAT = 'DISPOSITION EVENT'.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.DCREASCD" Name="Discontinuation Reason Code" Type="">
            <Description>
               <TranslatedText>Grouping of DCDECOD values to support summarizing study completion status and reason for discontinuation.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.DISCONFL" Name="Discontinued Study Flag" Type="">
            <Description>
               <TranslatedText>Set to 'Y' if DCREASCD ^= 'Completed'. Null otherwise.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.DISONSDT" Name="Disease Onset Date" Type="">
            <Description>
               <TranslatedText>MH.MHSTDTC where MHCAT = 'PRIMARY DIAGNOSIS' converted to SAS date.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.DSRAEFL" Name="Discontinued due to AE Flag" Type="">
            <Description>
               <TranslatedText>Set to 'Y' if DCREASCD = 'Adverse Event'. Null otherwise.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.DURDIS" Name="Duration of Disease" Type="">
            <Description>
               <TranslatedText>Number of months between VISIT1DT and DISONSDT.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.DURDSGR1" Name="Duration of Disease Group 1" Type="">
            <Description>
               <TranslatedText>Grouping DURDIS values as &lt; 12 and &gt;= 12.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.EDUCLVL" Name="Years of Education" Type="">
            <Description>
               <TranslatedText>SC.SCSTRESN where SC.SCTESTCD = 'YEARSEDU'.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.EFFFL" Name="Efficacy Population Flag" Type="">
            <Description>
               <TranslatedText>Set to 'Y' if SAFFL = 'Y' AND subject has at least one record in QS for ADAS-Cog with VISITNUM &gt; 3 AND at least one record in QS for CIBIC+. Set to 'N' otherwise.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.HEIGHTBL" Name="Baseline Height" Type="">
            <Description>
               <TranslatedText>VSSTRESN when VS.VSTESTCD = 'HEIGHT' and VS.VISITNUM = 1.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.ITTFL" Name="Intent-to-Treat Population Flag" Type="">
            <Description>
               <TranslatedText>Set to 'Y' if ARMCD ne ' '. Set to 'N' otherwise.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.MMSETOT" Name="MMSE Total Score" Type="">
            <Description>
               <TranslatedText>Sum of QS.QSORRES values for the subject.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.RACEN" Name="Race Code" Type="">
            <Description>
               <TranslatedText>Numeric code for RACE.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.RFENDT" Name="Study End Date Numeric" Type="">
            <Description>
               <TranslatedText>RFENDTC converted to SAS date.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.SAFFL" Name="Safety Population Flag" Type="">
            <Description>
               <TranslatedText>Set to 'Y' if ITTFL = 'Y' and TRTSDT is non-missing. Set to 'N' otherwise.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.SITEGR1" Name="Site Grouping 1 Derivation" Type="">
            <Description>
               <TranslatedText>Refer to SAP, Section 7.1 - if not pooled then SITEGR1=SITEID. If pooled, SITEGR1 will be 900.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.TRT01A" Name="Actual Treatment 01" Type="">
            <Description>
               <TranslatedText>TRT01A=TRT01P, i.e., no difference between actual and randomized treatment in this study.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.TRT01AN" Name="Actual Treatment 01 Code" Type="">
            <Description>
               <TranslatedText>Numeric code for TRT01A which corresponds to the randomized dose.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.TRT01PN" Name="Planned Treatment 01 Code" Type="">
            <Description>
               <TranslatedText>Numeric code for TRT01P which corresponds to the randomized dose.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.TRTDUR" Name="Treatment Duration" Type="">
            <Description>
               <TranslatedText>Calculated as: TRTEDT - TRTSDT + 1.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.TRTEDT" Name="Treatment End Date" Type="">
            <Description>
               <TranslatedText>The date of final dose (from the CRF) is EX.EXENDTC on the subject's last EX record. If the date of final dose is missing, impute based on last available treatment date.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.TRTSDT" Name="Treatment Start Date" Type="">
            <Description>
               <TranslatedText>SV.SVSTDTC when SV.VISITNUM=3, converted to SAS date.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.VISIT1DT" Name="Visit 1 Date" Type="">
            <Description>
               <TranslatedText>SV.SVSTDTC when SV.VISITNUM = 1, converted to SAS date.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.VISNUMEN" Name="End of Study Visit Number" Type="">
            <Description>
               <TranslatedText>If DS.VISITNUM = 13 where DSTERM = 'PROTOCOL COMPLETED' then VISNUMEN = 12, otherwise VISNUMEN = DS.VISITNUM where DSTERM = 'PROTOCOL COMPLETED'.</TranslatedText>
            </Description>
         </MethodDef>
         <MethodDef OID="MT.MT.WEIGHTBL" Name="Baseline Weight" Type="">
            <Description>
               <TranslatedText>VSSTRESN when VS.VSTESTCD = 'WEIGHT' and VS.VISITNUM = 3.</TranslatedText>
            </Description>
         </MethodDef>
      </MetaDataVersion>
   </Study>
